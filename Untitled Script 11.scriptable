  "name" : "Untitled Script 11",
  "script" : "\/\/ --- CONFIGURAÇÕES MESTRE ---\nconst MASTER_KEY_ADM = \"7WINS-ADMIN-PERMANENTE\"; \nconst ADM_EMAIL = \"Kauep7834@gmail.com\";\nconst ADM_SENHA = \"Kaka0101\";\n\nconst fm = FileManager.local();\nconst path = fm.joinPath(fm.documentsDirectory(), \"7wins_v17.json\");\n\nfunction lerDB() {\n  if (!fm.fileExists(path)) {\n    let inicial = { \n      keys: {}, \n      adm_logado: false, \n      usuario_logado: false,\n      funcoes: { \"HEAD LOCK\": false, \"TRACKING 2X\": false, \"PRECISION\": false, \"AIM FIX\": false } \n    };\n    fm.writeString(path, JSON.stringify(inicial));\n    return inicial;\n  }\n  return JSON.parse(fm.readString(path));\n}\n\nfunction gravarDB(dados) {\n  fm.writeString(path, JSON.stringify(dados));\n}\n\n\/\/ --- INTERFACE FULLSCREEN ---\nasync function abrirPainelFullScreen() {\n  let db = lerDB();\n  let html = `\n  <html>\n  <head>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <style>\n      body { background-color: #050505; color: white; font-family: -apple-system, sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; overflow: hidden; border: 4px solid #8A2BE2; box-sizing: border-box; }\n      .header { color: #FFD700; font-size: 22px; font-weight: bold; margin-bottom: 5px; }\n      .mira { font-size: 70px; color: #FF0000; margin: 10px 0; text-shadow: 0 0 15px red; }\n      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 90%; margin-bottom: 20px; }\n      .btn { background: #111; border: 2px solid #333; padding: 20px 5px; border-radius: 12px; text-align: center; font-size: 13px; font-weight: bold; color: #666; transition: 0.3s; }\n      .btn.active { background: rgba(138, 43, 226, 0.3); border-color: #00FFCC; color: #FFF; box-shadow: 0 0 10px #00FFCC55; }\n      .boot-section { width: 90%; border-top: 1px solid #222; padding-top: 15px; display: flex; flex-direction: column; gap: 10px; }\n      .launch-btn { background: linear-gradient(90deg, #8A2BE2, #4B0082); color: white; padding: 16px; border-radius: 10px; text-align: center; font-weight: bold; font-size: 14px; border: none; }\n      .launch-max { background: linear-gradient(90deg, #FF8C00, #FF4500); }\n    <\/style>\n  <\/head>\n  <body>\n    <div class=\"header\">✪ 7WINS ELITE<\/div>\n    <div class=\"mira\">⌖<\/div>\n    \n    <div class=\"grid\">\n      ${Object.keys(db.funcoes).map(f => `\n        <div id=\"${f}\" class=\"btn ${db.funcoes[f] ? 'active' : ''}\" onclick=\"toggle('${f}')\">${f}<\/div>\n      `).join('')}\n    <\/div>\n\n    <div class=\"boot-section\">\n      <button onclick=\"launch('AbrirFF')\" class=\"launch-btn\">🚀 ABRIR FREE FIRE<\/button>\n      <button onclick=\"launch('AbrirFFMax')\" class=\"launch-btn launch-max\">🚀 ABRIR FF MAX<\/button>\n    <\/div>\n\n    <script>\n      function toggle(name) {\n        document.getElementById(name).classList.toggle('active');\n        window.location.href = \"js-call:toggle:\" + name;\n      }\n      function launch(shortcutName) {\n        window.location.href = \"js-call:launch:\" + shortcutName;\n      }\n    <\/script>\n  <\/body>\n  <\/html>\n  `;\n\n  let wv = new WebView();\n  await wv.loadHTML(html);\n  \n  wv.shouldAllowRequest = (req) => {\n    if (req.url.startsWith(\"js-call:\")) {\n      let parts = req.url.split(\":\");\n      let action = parts[2];\n      let value = parts[3];\n\n      if (action === \"toggle\") {\n        let dbAtivo = lerDB();\n        dbAtivo.funcoes[value] = !dbAtivo.funcoes[value];\n        gravarDB(dbAtivo);\n      } \n      \n      if (action === \"launch\") {\n        \/\/ Chama o atalho nativo do iOS\n        Safari.open(\"shortcuts:\/\/run-shortcut?name=\" + value);\n      }\n      return false;\n    }\n    return true; \n  };\n\n  await wv.present(true);\n}\n\n\/\/ --- FLUXO DE LOGIN ---\nasync function main() {\n  let db = lerDB();\n  \n  \/\/ Login único para ADM via Memória\n  if (db.adm_logado || db.usuario_logado) {\n    await abrirPainelFullScreen();\n    return;\n  }\n\n  let menu = new Alert();\n  menu.title = \"SISTEMA 7WINS\";\n  menu.addAction(\"ENTRAR (KEY)\");\n  menu.addAction(\"ADM LOGIN\");\n  let res = await menu.presentSheet();\n\n  if (res === 1) {\n    let login = new Alert();\n    login.addTextField(\"Master Key \/ E-mail\");\n    login.addSecureTextField(\"Senha\");\n    login.addAction(\"LOGAR\");\n    await login.presentAlert();\n    let u = login.textFieldValue(0).toUpperCase().trim();\n    if (u === MASTER_KEY_ADM.toUpperCase() || (u.toLowerCase() === ADM_EMAIL.toLowerCase() && login.textFieldValue(1) === ADM_SENHA)) {\n      db.adm_logado = true;\n      gravarDB(db);\n      await abrirPainelFullScreen();\n    }\n  } else {\n    let auth = new Alert();\n    auth.addTextField(\"Insira sua Key\");\n    auth.addAction(\"ATIVAR\");\n    await auth.presentAlert();\n    let k = auth.textFieldValue(0).toUpperCase().trim();\n\n    if (k === MASTER_KEY_ADM.toUpperCase() || db.keys[k]) {\n      db.usuario_logado = true;\n      gravarDB(db);\n      await abrirPainelFullScreen();\n    }\n  }\n}\n\nawait main();\n",
  "share_sheet_inputs" : [

  ]
}